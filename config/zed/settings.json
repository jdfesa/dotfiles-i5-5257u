{
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "disable_ai": true,
  "auto_install_extensions": {
    "html": false
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "theme": "One Dark",
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/zsh",
        "args": ["--login"]
      }
    }
  }
}
