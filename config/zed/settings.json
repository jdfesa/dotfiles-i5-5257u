{
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "Zed",
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "disable_ai": true,
  "auto_install_extensions": {
    "html": false
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/zsh",
        "args": ["--login"]
      }
    }
  }
}
